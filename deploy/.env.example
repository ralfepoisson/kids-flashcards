# Copy to deploy/.env on the EC2 host and chmod 600; never commit real values.
# Build-image prints an immutable revision tag. The deployment script uses it.
KIDS_FLASHCARDS_IMAGE=kids-flashcards:REPLACE_WITH_FULL_GIT_REVISION
DATABASE_URL=postgresql+psycopg://kids_flashcards:REPLACE_WITH_PASSWORD@postgres:5432/kids_flashcards
POSTGRES_NETWORK=personal-projects-postgresql
LIFE2_APPLICATION_ID=REPLACE_WITH_REGISTERED_APPLICATION_UUID
LIFE2_AUTH_BASE_URL=REPLACE_WITH_LIFE2_AUTH_HTTPS_BASE_URL
# Absolute path; readable by UID10001 (Compose file secrets retain host mode).
LIFE2_JWT_SIGNING_KEY_FILE=/srv/apps/kids-flashcards/secrets/life2-jwt-key-base64
# Pre-create this directory, owned by UID10001:GID10001; never commit uploads.
UPLOADS_DIR=/srv/apps/kids-flashcards/uploads
FLASHCARDS_PORT=48100
