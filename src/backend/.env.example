# Replace YOUR_LOCAL_POSTGRES_ROLE with your local PostgreSQL role.
# If omitted, the app uses your OS username and localhost:5432.
# DATABASE_URL=postgresql+psycopg://YOUR_LOCAL_POSTGRES_ROLE@localhost:5432/kids_flashcards
# TEST_DATABASE_URL=postgresql+psycopg://YOUR_LOCAL_POSTGRES_ROLE@localhost:5432/kids_flashcards_test
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# UPLOAD_DIR=/absolute/path/to/persistent/uploads

# Register the callback URI in Life2 Auth and set its application ID.
LIFE2_APPLICATION_ID=
LIFE2_AUTH_BASE_URL=http://auth-service.localhost:46138
LIFE2_CALLBACK_URL=http://127.0.0.1:4200/auth/callback
# Base64-encoded Life2 HS256 signing key; never commit it.
LIFE2_JWT_SIGNING_KEY_FILE=/Users/ralfe/.life2-local/docker-secrets/life2-jwt-key-base64
# Alternatively set LIFE2_JWT_SIGNING_KEY_BASE64 via your secret store.
# Enable Secure session cookies when serving over HTTPS.
COOKIE_SECURE=false
